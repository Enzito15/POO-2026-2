<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" stylesheets="@style.css"
            fx:controller="pe.edu.upeu.proyect_final.controller.MainController"
            prefHeight="600.0" prefWidth="900.0">

    <!--Cabecera-->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header"
              BorderPane.alignment="CENTER">
            <children>
                <Label text="HOTEL" textFill="#014074">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                    <HBox.margin>
                        <Insets left="20.0"/>
                    </HBox.margin>

                </Label>
                <Label text="Residencias UPeU" textFill="#666666">
                    <HBox.margin>
                        <Insets left="10.0"/>
                    </HBox.margin>

                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Bienvenido, Usuario" textFill="#014074">
                    <font>
                        <Font name="System Italic" size="14.0"/>
                    </font>
                    <HBox.margin>
                        <Insets right="20.0"/>
                    </HBox.margin>

                </Label>
            </children>

        </HBox>
    </top>
    <!--Menu Izquierdo-->
    <left>
        <VBox prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Button maxWidth="-Infinity" onAction="#showHome" mnemonicParsing="false" styleClass="nav-button" text="inicio"/>
                <Button maxWidth="-Infinity" onAction="#showClient" mnemonicParsing="false" styleClass="nav-button" text="Clientes"/>
            </children>

        </VBox>
    </left>
    <!--Area de contenido-->
    <center>
        <VBox BorderPane.alignment="CENTER">
            <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS">
                <children>
                    <Label text="Seleccione una opcion" textFill="9999"/>
                </children>
            </StackPane>
            <HBox alignment="CENTER" prefHeight="20.0">
                <children>
                    <Label text="©copyright J-E Studios-2026" textFill="999999"/>

                </children>
            </HBox>
        </VBox>

    </center>

</BorderPane>
