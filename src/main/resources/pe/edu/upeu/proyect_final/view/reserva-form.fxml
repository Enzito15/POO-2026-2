<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.proyect_final.controller.ReservaFromController"
      spacing="15.0" stylesheets="@style.css" style="-fx-background-color: White">
    <padding>
       <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Nueva reserva" textFill="#014074">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>
        <Separator/>
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="120.0"/>
                <ColumnConstraints prefWidth="200.0"/>
                <ColumnConstraints prefWidth="150.0"/>
            </columnConstraints>
            <children>
                <!--Busqueda del Cliente-->
                <Label text="DNI Cliente" GridPane.rowIndex="0" />
                <TextField fx:id="txtDniBuscar" onKeyReleased="#buscarCleiente" promptText="Presione Enter" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label fx:id="lblNombreCliente" text="Cliente no encontrado" textFill="#999999" GridPane.columnIndex="2"
                GridPane.rowIndex="0"/>

                <!--Busqueda de habitacion-->
                <Label text="N° Habitacion" GridPane.rowIndex="1" />
                <TextField fx:id="txtNumHabBusqueda" onKeyReleased="#buscarhabitacion" promptText="Presione Enter" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="lblDetalleHab" text="Habitacion no encontrada" textFill="#999999" GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>
                <!--Fecha-->
                <Label text="Fecha Ingreso" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpIngreso" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Fecha Salida" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dpSalir" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Total(S/)" GridPane.rowIndex="4"/>
                <TextField GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false"
                        onAction="#handleCancelar" prefHeight="31.0" prefWidth="100.0" styleClass="button-action-delete" text="Cancelar"/>
                <Button mnemonicParsing="false"
                        onAction="#handleGuardar" prefHeight="31.0" prefWidth="100.0" styleClass="button-action-edit" text="Confirmar"/>
            </children>
        </HBox>
    </children>

</VBox>
